+def test_python_helper_exit_does_not_overwrite_parent_capture(tmp_path):
+    program = tmp_path / "parent.py"
+    program.write_text('''\
+import asyncio
+import json
+import os
+import subprocess
+import sys
+
+helper_code = """
+import asyncio
+import sys
+sys.stdin.read()
+async def helper_work():
+    await asyncio.sleep(.01)
+asyncio.run(helper_work())
+"""
+helper = subprocess.Popen([sys.executable, '-B', '-c', helper_code], stdin=subprocess.PIPE)
+async def parent_work():
+    await asyncio.sleep(.02)
+asyncio.run(parent_work())
+print(json.dumps({'parent_pid': os.getpid(), 'helper_pid': helper.pid}), flush=True)
+# Interpreter shutdown closes the pipe after the parent's capture is flushed.
+# The inherited helper then flushes its own, different Task graph.
+''')
+    capture = tmp_path / "graph.json"
+    env = dict(os.environ, PYTHONPATH=str(ROOT / "agents/python"),
+               COROSTITCH_ENABLE="1", COROSTITCH_OUT=str(capture),
+               COROSTITCH_SAMPLE_INTERVAL=".005")
+    env.pop("COROSTITCH_OUTPUT_OWNER_PID", None)
+    result = subprocess.run([sys.executable, '-B', str(program)], env=env,
+                            check=True, capture_output=True, text=True, timeout=10)
+    pids = json.loads(result.stdout)
+    parent = json.loads(capture.read_text())
+    assert any(s.get('function_name') == 'parent_work' for s in parent['segments'])
+    assert not any(s.get('function_name') == 'helper_work' for s in parent['segments'])
+    child_file = tmp_path / f"graph.pid-{pids['helper_pid']}.json"
+    child = json.loads(child_file.read_text())
+    assert any(s.get('function_name') == 'helper_work' for s in child['segments'])
+    assert parent['agent']['process_id'] == pids['parent_pid']
+    assert child['agent']['process_id'] == pids['helper_pid']
+    assert parent['agent']['output_owner_process_id'] == child['agent']['output_owner_process_id'] == pids['parent_pid']
+
